generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Boat {
  id       Int         @id @default(autoincrement())
  // Unique, system-generated public identifier (e.g. shown in the admin/seller UI)
  boatId   String      @unique @default(cuid())
  name     String
  // Raw source text for the price/status cell as originally imported
  // (e.g. "£69,950", "sold", "under offer"). Kept for reference/audit —
  // the app uses `price` and the status booleans below instead.
  cost     String
  // Real numeric asking price. Null when there's no price yet (sold /
  // under offer / not set) — an admin dashboard will manage this directly.
  price        Int?
  isSold       Boolean @default(false)
  isUnderOffer Boolean @default(false)
  isFeatured   Boolean @default(false)
  imageUrl String?
  sellerId Int
  seller   Seller      @relation(fields: [sellerId], references: [id])
  images   BoatImage[]
  listings BoatListing[]
  customFields BoatCustomField[]
  bookings Booking[]
  sales    Sale[]

  // History
  cinNumber              String?
  crtNumber              String?
  licenseNumber          String?
  previousOwners         String?
  engineServiceHistory   String?
  boilerServiceHistory   String?
  survey                 String?
  blacking               String?
  anodes                 String?
  documentationAvailable String?

  // Dimensions
  draft            String?
  internalHeadroom String?
  saloonLength     String?
  galleyLength     String?
  bathroomLength   String?
  bedroomLength    String?

  // Engine
  engine             String?
  hours              String?
  gearbox            String?
  bowthruster        String?
  weedhatch          String?
  dieselTankCapacity String?
  engineExtraNotes   String?

  // Heating
  centralHeating    String?
  solidFuelStove    String?
  sourceOfHotWater  String?
  waterTank         String?
  waterTankCapacity String?
  heatingExtraNotes String?

  // Electrical
  alternator           String?
  batteries            String?
  lighting             String?
  inverterCharger      String?
  landlineSocket       String?
  galvanicIsolator     String?
  electricalExtraNotes String?

  // Gas
  gasBottles    String?
  appliances    String?
  gasExtraNotes String?

  // Interior - general
  insulation         String?
  ballast            String?
  ceiling            String?
  cabinSides         String?
  hullSides          String?
  flooring           String?
  sideDoors          String?
  windows            String?
  interiorExtraNotes String?

  // Interior - Saloon
  saloonSeating String?
  saloonDinette String?

  // Interior - Galley
  galleyCooker         String?
  galleyFridgeFreezer  String?
  galleyMicrowave      String?
  galleyWashingMachine String?
  galleyExtraNotes     String?

  // Interior - Bathroom
  bathroomToilet            String?
  bathroomWasteTankCapacity String?
  bathroomBathShower        String?
  bathroomVanityBasin       String?
  bathroomExtraNotes        String?

  // Interior - Bedroom
  bedroomBed        String?
  bedroomDinette    String?
  bedroomExtraNotes String?

  // Other
  tv                  String?
  covers              String?
  navigationEquipment String?
  hullBuilder         String?
  fitOut              String?
  year                String?
  steelSpec           String?
  lastService         String?
  boatSafety          String?
  recentSurvey        String?

  // Key Details
  boatName   String?
  location   String?
  lengthBeam String?
  noOfBerths String?
  sternType  String?
  yearBuilt  String?
  builder    String?
  boatType   String?
  overview   String? @db.Text

  // Media
  // TEXT (not VARCHAR) so these don't push the already-wide Boat row over
  // MySQL's 65535-byte row-size limit — see migration history.
  // brochureUrl is a local path under /uploads (see Backend/src/lib/upload.ts), not an external link.
  brochureUrl    String? @db.Text
  videoUrl       String? @db.Text
  virtualTourUrl String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BoatImage {
  id        Int      @id @default(autoincrement())
  boatId    Int
  boat      Boat     @relation(fields: [boatId], references: [id], onDelete: Cascade)
  path      String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([boatId])
}

// Seller-defined extra spec rows (label + value) that vary per boat — see the
// Additional Fields tab of the Add Boat form. A child table rather than columns
// on Boat because the Boat row is already near MySQL's 65535-byte row-size limit.
model BoatCustomField {
  id        Int      @id @default(autoincrement())
  boatId    Int
  boat      Boat     @relation(fields: [boatId], references: [id], onDelete: Cascade)
  label     String
  value     String   @db.Text
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([boatId])
}

model BlogPost {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  title     String
  // Raw HTML pasted by an admin (e.g. from a rich text editor) — stored and
  // rendered as-is.
  content   String   @db.Text
  readTime  String
  author    String
  date      String
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Seller {
  id          Int      @id @default(autoincrement())
  // Unique, system-generated public identifier (e.g. shown to the seller/admin UI)
  sellerId    String   @unique @default(cuid())
  name        String
  email       String   @unique
  // Hashed password (e.g. bcrypt) used for seller-portal login
  password    String?
  phone       String?
  location    String?
  // Local path under /uploads (see Backend/src/lib/upload.ts), not an external link.
  avatarUrl   String?
  joiningDate DateTime @default(now())
  // Admin-managed seller pipeline stage — independent of BoatListing status.
  status      SellerStatus @default(NEW)
  boats       Boat[]
  listings    BoatListing[]
  sales       Sale[]
}

enum SellerStatus {
  NEW
  CONTACTED
  LISTED
  LOST
}

model Admin {
  id          Int      @id @default(autoincrement())
  // Unique, system-generated public identifier (e.g. shown in the admin UI)
  adminId     String   @unique @default(cuid())
  name        String
  email       String   @unique
  // Hashed password (scrypt, see src/lib/password.ts) used for admin-portal login
  password    String?
  phone       String?
  // Local path under /uploads (see Backend/src/lib/upload.ts), not an external link.
  avatarUrl   String?
  joiningDate DateTime @default(now())
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
}

model BoatListing {
  id        Int           @id @default(autoincrement())
  boatId    Int
  boat      Boat          @relation(fields: [boatId], references: [id], onDelete: Cascade)
  sellerId  Int
  seller    Seller        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  status    ListingStatus @default(PENDING)
  comments  ListingComment[]
  createdAt DateTime      @default(now())

  // Seller preferences captured when this listing was submitted
  // (Key Details step of the Add Boat form).
  sellTimeline     String?
  contactTime      String?
  listerType       String?
  additionalNotes  String?  @db.Text
  agreedToContact  Boolean  @default(true)

  @@index([boatId])
  @@index([sellerId])
}

model ListingComment {
  id         Int         @id @default(autoincrement())
  listingId  Int
  listing    BoatListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  content    String      @db.Text
  author     String?
  // True when this comment/reply was posted by the seller (from the Comments module),
  // as opposed to a buyer/admin comment left on the listing.
  fromSeller Boolean     @default(false)
  // Self-relation: a null parentId is a top-level comment, non-null is a reply to it.
  // Only one level deep is used by the UI today.
  parentId   Int?
  parent     ListingComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    ListingComment[] @relation("CommentReplies")
  createdAt  DateTime    @default(now())

  @@index([listingId])
  @@index([parentId])
}

// Admin's bookable time — a fixed 2-hour block. Global, not per-boat: since
// it's the same admin's time either way, a slot can only ever back one
// active (PENDING/APPROVED) booking regardless of which boat it's for.
model AvailabilitySlot {
  id        Int       @id @default(autoincrement())
  startsAt  DateTime
  endsAt    DateTime
  bookings  Booking[]
  createdAt DateTime  @default(now())

  // No two slots may start at the same instant — one slot per day+hour.
  @@unique([startsAt])
}

enum BuyerStatus {
  NEW
  CONTACTED
  VIEWING_BOOKED
  WON
  LOST
}

// Created the moment someone submits a viewing-booking request — see
// Booking below. No portal/login for buyers; this is just a contact record.
model Buyer {
  id        Int         @id @default(autoincrement())
  buyerId   String      @unique @default(cuid())
  firstName String
  surname   String
  email     String
  phone     String?
  // How this buyer record was created (e.g. "Booking", "Manual").
  source    String      @default("Booking")
  status    BuyerStatus @default(NEW)
  bookings  Booking[]
  sales     Sale[]
  createdAt DateTime    @default(now())

  @@index([email])
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
}

model Booking {
  id        Int              @id @default(autoincrement())
  slotId    Int
  slot      AvailabilitySlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  boatId    Int
  boat      Boat             @relation(fields: [boatId], references: [id], onDelete: Cascade)
  buyerId   Int
  buyer     Buyer            @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  status    BookingStatus    @default(PENDING)
  notes     String?          @db.Text
  createdAt DateTime         @default(now())

  @@index([slotId])
  @@index([boatId])
  @@index([buyerId])
}

enum LeadStatus {
  NEW
  CONTACTED
  LISTED
  LOST
}

// Seller-side inquiry pipeline — fully admin-driven (manual entry), tracked
// separately from real Seller accounts (see SellerStatus on Seller). No
// automatic conversion/linking between the two.
model Lead {
  id        Int        @id @default(autoincrement())
  leadId    String     @unique @default(cuid())
  firstName String
  surname   String
  email     String
  phone     String?
  address   String?
  source    String?
  status    LeadStatus @default(NEW)
  notes     String?    @db.Text
  createdAt DateTime   @default(now())
}

enum SaleStatus {
  CURRENT
  COMPLETED
  CANCELLED
}

// Manual deal log — admin picks seller + buyer + boat and enters the figures
// by hand. No automated side effects on Buyer/Lead status (see overview spec).
model Sale {
  id         Int        @id @default(autoincrement())
  saleId     String     @unique @default(cuid())
  boatId     Int
  boat       Boat       @relation(fields: [boatId], references: [id], onDelete: Cascade)
  sellerId   Int
  seller     Seller     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  buyerId    Int
  buyer      Buyer      @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  soldPrice  Int
  deposit    Int        @default(0)
  commission Int        @default(0)
  status     SaleStatus @default(CURRENT)
  createdAt  DateTime   @default(now())

  @@index([boatId])
  @@index([sellerId])
  @@index([buyerId])
}
