{
  "name": "boat-brokers",
  "version": "1.0.0",
  "private": true,
  "description": "Boat Brokers full-stack website (React + TypeScript client, Node.js + Express + Prisma server, MySQL database)",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build:client": "npm run build -w client",
    "build:server": "npm run build -w server",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "prisma:generate": "npm run prisma:generate -w server",
    "prisma:migrate": "npm run prisma:migrate -w server"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  }
}
